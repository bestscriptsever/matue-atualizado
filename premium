        if not scroll.Visible then TweenService:Create(btn, Anim.Fast, {TextColor3 = Theme.Text}):Play() end 
    end)
    btn.MouseLeave:Connect(function() 
        if not scroll.Visible then TweenService:Create(btn, Anim.Fast, {TextColor3 = Theme.TextMuted}):Play() end 
    end)

