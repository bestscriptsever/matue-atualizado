local hudButtons = {}

local function CreateHudButton(id, text, actionType, actionKey)
    local btn = Instance.new("TextButton", mobileHudGui)
    btn.Name = id
    btn.Size = UDim2.new(0, 50, 0, 50)
    btn.Position = UDim2.new(0.8, math.random(-30, 30), 0.5, math.random(-50, 50))
    btn.BackgroundColor3 = Theme.Surface
    btn.TextColor3 = Theme.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Text = text
    btn.Visible = false
    btn.Active = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    
    local strk = Instance.new("UIStroke", btn)
    strk.Color = Theme.Border
    strk.Thickness = 1.5

    local dragging = false
    local dragStart, startPos

    btn.InputBegan:Connect(function(input)
        if State.Toggles.LockHUD then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if State.Toggles.LockHUD then dragging = false return end
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local clickStart = 0
    local clickStartPos = Vector3.zero
    btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            clickStart = tick()
            clickStartPos = inp.Position
            TweenService:Create(btn, Anim.Fast, {BackgroundColor3 = Theme.SurfaceHover}):Play()
        end
    end)
    
    btn.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(btn, Anim.Fast, {BackgroundColor3 = Theme.Surface}):Play()
            if tick() - clickStart < 0.3 and (inp.Position - clickStartPos).Magnitude < 10 then
                if actionType == "Toggle" then
                    State.Toggles[actionKey] = not State.Toggles[actionKey]
                    if VisualUpdaters[actionKey] then for _, fn in ipairs(VisualUpdaters[actionKey]) do fn(State.Toggles[actionKey]) end end
                    if LogicActions[actionKey] then LogicActions[actionKey]() end
                    SaveSystem()
                    strk.Color = State.Toggles[actionKey] and Theme.Primary or Theme.Border
                    btn.TextColor3 = State.Toggles[actionKey] and Theme.Primary or Theme.Text
                elseif actionType == "Button" then
                    if LogicActions[actionKey] then LogicActions[actionKey]() end
                end
            end
        end
    end)

    hudButtons[id] = {btn = btn, strk = strk, type = actionType, key = actionKey}
    return btn
end

