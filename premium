            local isRagdolled = (newState == Enum.HumanoidStateType.Physics or newState == Enum.HumanoidStateType.Ragdoll or newState == Enum.HumanoidStateType.FallingDown)
            if isRagdolled then startCountdown() lastHitTimeForCarry = tick() end
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or UserInputService:GetFocusedTextBox() then return end 

    if listeningAction then
        if input.UserInputType == Enum.UserInputType.Keyboard or string.find(input.UserInputType.Name, "Gamepad") then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                for k, v in pairs(State.Binds) do
                    if v == input.KeyCode and k ~= listeningAction.name then
                        State.Binds[k] = Enum.KeyCode.Unknown
                    end
                end
                State.Binds[listeningAction.name] = input.KeyCode
                atualizarTextosDosBotoes() 
                listeningAction = nil 
                SaveSystem()
                return 
            end
        end
    end
    
    for keyName, keyCode in pairs(State.Binds) do
        if input.KeyCode == keyCode and keyCode ~= Enum.KeyCode.Unknown then
            if keyName == "TPDown" then if LogicActions.TPDown then LogicActions.TPDown() end
            elseif keyName == "Drop" then if LogicActions.Drop then LogicActions.Drop() end
            elseif keyName == "InstaReset" then if LogicActions.InstaReset then LogicActions.InstaReset() end
            elseif keyName == "SpeedMode" then
                if State.Values.SpeedMode == "Normal" then
                    State.Values.SpeedMode = "Lagger"
                else
                    State.Values.SpeedMode = "Normal"
                end
                if InputUpdaters.SpeedMode then 
                    InputUpdaters.SpeedMode(State.Values.SpeedMode) 
                end
                SaveSystem()
            elseif State.Toggles[keyName] ~= nil then
                State.Toggles[keyName] = not State.Toggles[keyName]
                if VisualUpdaters[keyName] then 
                    for _, fn in ipairs(VisualUpdaters[keyName]) do fn(State.Toggles[keyName]) end 
                end
                if LogicActions[keyName] then LogicActions[keyName]() end
                SaveSystem()
            end
        end
    end
end)

LogicActions.RemoveAccs = function()
    if State.Toggles.RemoveAccs then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:RemoveAccessories() end) end
                
                for _, obj in ipairs(p.Character:GetDescendants()) do
                    if obj:IsA("Accessory") or obj:IsA("Hat") then 
                        pcall(function() 
                            obj.Parent = nil
                            obj:Destroy()   
                        end) 
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if _G.Aimlock_Script_Versao ~= minhaVersao then break end
        if State.Toggles.RemoveAccs then pcall(LogicActions.RemoveAccs) end
    end
end)

local SaveLoadSuccess = pcall(function()
    if isfile(AutoSavePath) then
        local data = HttpService:JSONDecode(readfile(AutoSavePath))
        if data.Values then for k, v in pairs(data.Values) do State.Values[k] = v if InputUpdaters[k] then InputUpdaters[k](v) end end end
        if data.Binds then 
            for k, v in pairs(data.Binds) do 
                if State.Binds[k] ~= nil then pcall(function() State.Binds[k] = Enum.KeyCode[v] end) end 
            end 
            atualizarTextosDosBotoes() 
        end
        if data.IsMinimized ~= nil then ExecMinimize(data.IsMinimized) end
        if data.Toggles then
            for k, savedValue in pairs(data.Toggles) do
                if State.Toggles[k] ~= nil then
                    State.Toggles[k] = savedValue
                    if VisualUpdaters[k] then for _, fn in ipairs(VisualUpdaters[k]) do fn(savedValue) end end
                    if savedValue and LogicActions[k] then LogicActions[k]() end
                end
            end
        end
    end
    isDataLoaded = true
    
    -- Atualiza os botões Mobile de acordo com o Save e a checagem automática
    UpdateHUDVisibility()
    if LogicActions.HUDScale then LogicActions.HUDScale() end
end)

if not SaveLoadSuccess then 
    isDataLoaded = true 
    UpdateHUDVisibility()
    if LogicActions.HUDScale then LogicActions.HUDScale() end
end

