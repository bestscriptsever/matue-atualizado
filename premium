local function getTracer(plr)
    if MyAddonsState.tracerFrames[plr] then return MyAddonsState.tracerFrames[plr] end
    local data = {}
    
    local line = Instance.new("Frame")
    line.BackgroundColor3 = MyAddonsState.LIGHT_PURPLE
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.ZIndex = 1
    line.Visible = false
    line.Parent = MyAddonsState.tracerGui
    data.Line = line
    
    data.Box = {}
    for i = 1, 4 do
        local b = Instance.new("Frame")
        b.BackgroundColor3 = MyAddonsState.LIGHT_PURPLE
        b.BorderSizePixel = 0
        b.ZIndex = 1
        b.Visible = false
        b.Parent = MyAddonsState.tracerGui
        data.Box[i] = b
    end
    
    MyAddonsState.tracerFrames[plr] = data
    return data
end

LogicActions.ESPTracer = function()
    if State.Toggles.ESPTracer then
        if MyAddonsState.tracerConn then MyAddonsState.tracerConn:Disconnect() end
        MyAddonsState.tracerConn = RunService.RenderStepped:Connect(function()
            if not State.Toggles.ESPTracer then return end
            local cam = workspace.CurrentCamera
            if not cam then return end
            local origin = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
            
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player then
                    local tData = getTracer(plr)
                    local line = tData.Line
                    local box = tData.Box
                    local char = plr.Character
                    
                    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                        local root = char.HumanoidRootPart
                        local rawPos = root.CFrame.Position
                        local finalPos = rawPos
                        
                        if MyAddonsState.lastStablePos[plr] then
                            local dist = (rawPos - MyAddonsState.lastStablePos[plr]).Magnitude
                            if dist > 30 then
                                MyAddonsState.glitchFrames[plr] = (MyAddonsState.glitchFrames[plr] or 0) + 1
                                if MyAddonsState.glitchFrames[plr] < 10 then
                                    finalPos = MyAddonsState.lastStablePos[plr]
                                else
                                    MyAddonsState.lastStablePos[plr] = rawPos
                                    finalPos = rawPos
                                end
                            else
                                MyAddonsState.glitchFrames[plr] = 0
                                finalPos = MyAddonsState.lastStablePos[plr]:Lerp(rawPos, 0.4)
                                MyAddonsState.lastStablePos[plr] = finalPos
                            end
                        else
                            MyAddonsState.lastStablePos[plr] = rawPos
                        end

                        local screenPos, onScreen = cam:WorldToViewportPoint(finalPos)
                        
                        if onScreen and screenPos.Z > 0 then
                            local targetPos = Vector2.new(screenPos.X, screenPos.Y)
                            local distance = (targetPos - origin).Magnitude
                            local depth = screenPos.Z
                            
                            local thickness = math.clamp(math.floor(80 / math.max(depth, 1)), 2, 6)
                            
                            line.Size = UDim2.new(0, thickness, 0, distance)
                            line.Position = UDim2.new(0, (origin.X + targetPos.X) / 2, 0, (origin.Y + targetPos.Y) / 2)
                            
                            local angle = math.atan2(targetPos.Y - origin.Y, targetPos.X - origin.X)
                            line.Rotation = math.deg(angle) - 90
                            line.Visible = true
                            
                            local headPos = finalPos + Vector3.new(0, 3, 0)
                            local legPos = finalPos - Vector3.new(0, 3.5, 0)
                            local headScreen = cam:WorldToViewportPoint(headPos)
                            local legScreen = cam:WorldToViewportPoint(legPos)
                            
                            local boxHeight = math.abs(headScreen.Y - legScreen.Y)
                            local topY = math.min(headScreen.Y, legScreen.Y)
                            local boxWidth = boxHeight * 0.65
                            local leftX = targetPos.X - boxWidth / 2
                            
                            box[1].Size = UDim2.new(0, boxWidth, 0, thickness)
                            box[1].Position = UDim2.new(0, leftX, 0, topY)
                            box[1].Visible = true
                            
                            box[2].Size = UDim2.new(0, boxWidth, 0, thickness)
                            box[2].Position = UDim2.new(0, leftX, 0, topY + boxHeight - thickness)
                            box[2].Visible = true
                            
                            box[3].Size = UDim2.new(0, thickness, 0, boxHeight)
                            box[3].Position = UDim2.new(0, leftX, 0, topY)
                            box[3].Visible = true
                            
                            box[4].Size = UDim2.new(0, thickness, 0, boxHeight)
                            box[4].Position = UDim2.new(0, leftX + boxWidth - thickness, 0, topY)
                            box[4].Visible = true
                        else
                            line.Visible = false
                            for i=1,4 do box[i].Visible = false end
                        end
                    else
                        if tData then
                            tData.Line.Visible = false
                            for i=1,4 do tData.Box[i].Visible = false end
                        end
                    end
                end
            end
        end)
    else
        if MyAddonsState.tracerConn then MyAddonsState.tracerConn:Disconnect(); MyAddonsState.tracerConn = nil end
        for _, tData in pairs(MyAddonsState.tracerFrames) do
            pcall(function() 
                tData.Line.Visible = false 
                for i=1,4 do tData.Box[i].Visible = false end
            end)
        end
    end
end

local function getPredictESP(plr)
    if MyAddonsState.predictFrames[plr] then return MyAddonsState.predictFrames[plr] end
    
    if not MyAddonsState.predictMasterFolder or not MyAddonsState.predictMasterFolder.Parent then
        MyAddonsState.predictMasterFolder = Instance.new("Folder")
        MyAddonsState.predictMasterFolder.Name = "_MatuePredictMaster"
        local success = pcall(function() MyAddonsState.predictMasterFolder.Parent = workspace.CurrentCamera end)
        if not success then MyAddonsState.predictMasterFolder.Parent = workspace end
    end

    local folder = Instance.new("Folder")
    folder.Name = "_predict_" .. plr.Name
    folder.Parent = MyAddonsState.predictMasterFolder

    local circle = Instance.new("Part")
    circle.Shape = Enum.PartType.Cylinder
    circle.Size = Vector3.new(0.5, 8, 8)
    circle.Material = Enum.Material.Neon
    circle.Color = Theme.Primary
    circle.Transparency = 0.3
    circle.Anchored = true
    circle.CanCollide = false
    circle.CanQuery = false
    circle.CastShadow = false
    circle.Parent = folder
    
    local attGround = Instance.new("Attachment")
    attGround.Parent = circle

    local attPlayer = Instance.new("Attachment")
    
    local beam = Instance.new("Beam")
    beam.Attachment0 = attPlayer
    beam.Attachment1 = attGround
    beam.Color = ColorSequence.new(Theme.Primary)
    beam.FaceCamera = true
    beam.Width0 = 0.5
    beam.Width1 = 3.0
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.8),
        NumberSequenceKeypoint.new(1, 0.2)
    })
    beam.Parent = folder

    local data = {Folder = folder, Circle = circle, Beam = beam, AttGround = attGround, AttPlayer = attPlayer}
    MyAddonsState.predictFrames[plr] = data
    return data
end

LogicActions.PredictESP = function()
    if State.Toggles.PredictESP then
        if MyAddonsState.predictConn then MyAddonsState.predictConn:Disconnect() end
        MyAddonsState.predictConn = RunService.RenderStepped:Connect(function()
            if not State.Toggles.PredictESP then return end
            
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player then
                    local pData = getPredictESP(plr)
                    local char = plr.Character
                    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                        local root = char.HumanoidRootPart
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        local ignore = {char, player.Character}
                        if MyAddonsState.predictMasterFolder then table.insert(ignore, MyAddonsState.predictMasterFolder) end
                        rp.FilterDescendantsInstances = ignore
                        
                        local rayHit = workspace:Raycast(root.Position, Vector3.new(0, -5000, 0), rp)
                        if rayHit then
                            local hitPos = rayHit.Position
                            
                            pData.Circle.CFrame = CFrame.lookAt(hitPos, hitPos + rayHit.Normal) * CFrame.Angles(0, math.pi/2, 0)
                            pData.Circle.Transparency = 0.3
                            
                            pData.AttPlayer.Parent = root
                            pData.AttPlayer.Position = Vector3.zero
                            
                            pData.Beam.Enabled = true
                        else
                            pData.Circle.Transparency = 1
                            pData.Beam.Enabled = false
                        end
                    else
                        if pData then
                            pData.Circle.Transparency = 1
                            pData.Beam.Enabled = false
                        end
                    end
                end
            end
        end)
    else
        if MyAddonsState.predictConn then MyAddonsState.predictConn:Disconnect(); MyAddonsState.predictConn = nil end
        for _, pData in pairs(MyAddonsState.predictFrames) do
            pcall(function() 
                pData.Circle.Transparency = 1
                pData.Beam.Enabled = false
            end)
        end
    end
end

