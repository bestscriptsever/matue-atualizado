    else
        minBtn.Visible = true
        TweenService:Create(mainFrame, Anim.Smooth, { Size = UDim2.new(0, 400, 0, 360), Position = lastMaximizedPos }):Play()
        task.delay(0.2, function() contentWrapper.Visible = true end)
